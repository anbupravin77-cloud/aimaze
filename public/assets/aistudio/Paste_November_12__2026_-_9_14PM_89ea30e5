        /* ============================================================================
           SECTION 1: FROM-SCRATCH DATA STRUCTURES (ZERO BUILT-IN ARRAY MUTATORS)
           ============================================================================ */

        /**
         * NON-LINEAR DATA STRUCTURE: Weighted Directed Graph
         * GraphEdge represents a directed transition in a vertex's singly-linked adjacency list.
         */
        let curMaskKey = '';      // bonus-collection state (part of the RL state)
        let stepMaskBefore = '';
        let collectedList = [];

        class GraphEdge {
            constructor(dir, targetNode, baseReward, isPortal = false, isBoost = false) {
                this.dir = dir;               // 'UP' | 'DOWN' | 'LEFT' | 'RIGHT'
                this.targetNode = targetNode; // Pointer to destination GraphNode
                this.baseReward = baseReward; // Immediate transition reward (-1, 0, -50, +100)
                this.qMap = {};               // Q(s, a) per bonus-collection state (s = tile + bonuses taken)
                this.isPortal = isPortal;     // True if transition warps via Portal A <-> B
                this.isBoost = isBoost;       // True if transition slides via Boost Pad
                this.next = null;             // Pointer to next GraphEdge in linked list
            }
        }

        /**
         * GraphNode represents a single vertex (row, col) on the 10x10 Gridworld.
         */
        Object.defineProperty(GraphEdge.prototype, 'qValue', {
            get() { return this.qMap[curMaskKey] || 0; },
            set(v) { this.qMap[curMaskKey] = v; }
        });

        class GraphNode {
            constructor(row, col, type = 'EMPTY', boostDir = 'RIGHT') {
                this.row = row;
                this.col = col;
                this.type = type;         // 'EMPTY' | 'WALL' | 'TRAP' | 'BOOST' | 'PORTAL_A' | 'PORTAL_B' | 'BONUS' | 'START' | 'GOAL'
                this.boostDir = boostDir; // 'UP' | 'DOWN' | 'LEFT' | 'RIGHT' (used when type === 'BOOST')
                this.edgesHead = null;    // Head pointer of outgoing GraphEdge linked list
            }

            /**
             * Appends a directed GraphEdge to this vertex's adjacency linked list.
             */
            addEdge(dir, targetNode, baseReward, isPortal = false, isBoost = false) {
                const newEdge = new GraphEdge(dir, targetNode, baseReward, isPortal, isBoost);
                if (this.edgesHead === null) {
                    this.edgesHead = newEdge;
                    return;
                }
                let curr = this.edgesHead;
                while (curr.next !== null) {
                    curr = curr.next;
                }
                curr.next = newEdge;
            }

            /**
             * Clears outgoing adjacency list.
             */
            clearEdges() {
                this.edgesHead = null;
            }

            /**
             * Finds outgoing GraphEdge matching direction string.
             */
            getEdge(dir) {
                let curr = this.edgesHead;
                while (curr !== null) {
                    if (curr.dir === dir) return curr;
                    curr = curr.next;
                }
                return null;
            }

            /**
             * Traverses outgoing GraphEdges to return max_a Q(s, a).
             */
            getMaxQ() {
                if (this.edgesHead === null) return 0.0;
                let maxVal = -Infinity;
                let curr = this.edgesHead;
                while (curr !== null) {
                    if (curr.qValue > maxVal) {
                        maxVal = curr.qValue;
                    }
                    curr = curr.next;
                }
                return maxVal === -Infinity ? 0.0 : maxVal;
            }

            /**
             * Returns the outgoing GraphEdge with the highest Q-value (random tie-break).
             */
            getBestEdge() {
                if (this.edgesHead === null) return null;
                const maxVal = this.getMaxQ();
                let tieCount = 0;

                let curr = this.edgesHead;
                while (curr !== null) {
                    if (Math.abs(curr.qValue - maxVal) < 1e-6) {
                        tieCount++;
                    }
                    curr = curr.next;
                }

                const pickIndex = Math.floor(Math.random() * tieCount);
                let seen = 0;
                curr = this.edgesHead;
                while (curr !== null) {
                    if (Math.abs(curr.qValue - maxVal) < 1e-6) {
                        if (seen === pickIndex) return curr;
                        seen++;
                    }
                    curr = curr.next;
                }
                return this.edgesHead;
            }
        }

        /**
         * Custom Linked Queue (BFSNode / BFSQueue) used exclusively by checkPathExistsBFS().
         */
        class BFSNode {
            constructor(graphNode) {
                this.graphNode = graphNode;
                this.next = null;
            }
        }

        class BFSQueue {
            constructor() {
                this.front = null;
                this.rear = null;
            }

            enqueue(graphNode) {
                const node = new BFSNode(graphNode);
                if (this.rear === null) {
                    this.front = node;
                    this.rear = node;
                } else {
                    this.rear.next = node;
                    this.rear = node;
                }
            }

            dequeue() {
                if (this.front === null) return null;
                const removed = this.front;
                this.front = this.front.next;
                if (this.front === null) {
                    this.rear = null;
                }
                return removed.graphNode;
            }

            isEmpty() {
                return this.front === null;
            }
        }

        /**
         * NON-LINEAR GRAPH CONTAINER: WeightedGraph
         */
        class WeightedGraph {
            constructor(rows = 10, cols = 10) {
                this.rows = rows;
                this.cols = cols;
                this.nodes = new Array(rows);
                for (let r = 0; r < rows; r++) {
                    this.nodes[r] = new Array(cols);
                    for (let c = 0; c < cols; c++) {
                        this.nodes[r][c] = new GraphNode(r, c, 'EMPTY', 'RIGHT');
                    }
                }
                this.startNode = this.nodes[0][0];
                this.goalNode = this.nodes[rows - 1][cols - 1];
                this.startNode.type = 'START';
                this.goalNode.type = 'GOAL';
                this.portalANode = null;
                this.portalBNode = null;
                this.rebuildEdges(true);
            }

            getNode(r, c) {
                if (r < 0 || r >= this.rows || c < 0 || c >= this.cols) return null;
                return this.nodes[r][c];
            }

            getDirectionDelta(dir) {
                if (dir === 'UP') return { dr: -1, dc: 0 };
                if (dir === 'DOWN') return { dr: 1, dc: 0 };
                if (dir === 'LEFT') return { dr: 0, dc: -1 };
                return { dr: 0, dc: 1 };
            }

            /**
             * Rebuilds all directed GraphEdge adjacency lists across the 10x10 grid,
             * resolving Boost Pad slides and Portal A <-> B warps directly in graph edges.
             */
            rebuildEdges(resetQ = false) {
                // Locate active Portals A and B
                this.portalANode = null;
                this.portalBNode = null;
                for (let r = 0; r < this.rows; r++) {
                    for (let c = 0; c < this.cols; c++) {
                        if (this.nodes[r][c].type === 'PORTAL_A') this.portalANode = this.nodes[r][c];
                        if (this.nodes[r][c].type === 'PORTAL_B') this.portalBNode = this.nodes[r][c];
                    }
                }

                const dirs = ['UP', 'DOWN', 'LEFT', 'RIGHT'];

                for (let r = 0; r < this.rows; r++) {
                    for (let c = 0; c < this.cols; c++) {
                        const node = this.nodes[r][c];

                        // Preserve existing learned Q-values when editing tiles
                        const savedQ = { UP: {}, DOWN: {}, LEFT: {}, RIGHT: {} };
                        if (!resetQ) {
                            let e = node.edgesHead;
                            while (e !== null) {
                                savedQ[e.dir] = e.qMap;
                                e = e.next;
                            }
                        }

                        node.clearEdges();

                        // Walls and Terminal States emit no outgoing transitions
                        if (node.type === 'WALL' || node.type === 'GOAL' || node.type === 'TRAP') {
                            continue;
                        }

                        for (let d = 0; d < 4; d++) {
                            const dir = dirs[d];
                            const delta = this.getDirectionDelta(dir);
                            const nr = r + delta.dr;
                            const nc = c + delta.dc;
                            const neighbor = this.getNode(nr, nc);

                            if (neighbor === null || neighbor.type === 'WALL') {
                                continue;
                            }

                            let finalTarget = neighbor;
                            let baseReward = -1;
                            let isPortal = false;
                            let isBoost = false;

                            // Mechanic 1: One-Way Boost Pad slides 1 extra tile in boostDir for 0 step cost
                            if (neighbor.type === 'BOOST') {
                                isBoost = true;
                                baseReward = 0;
                                const bDelta = this.getDirectionDelta(neighbor.boostDir);
                                const slideNode = this.getNode(neighbor.row + bDelta.dr, neighbor.col + bDelta.dc);
                                if (slideNode !== null && slideNode.type !== 'WALL') {
                                    finalTarget = slideNode;
                                }
                            }

                            // Mechanic 2: Paired Wormhole Portals warp immediately across the board for 0 cost
                            if (finalTarget.type === 'PORTAL_A' && this.portalBNode !== null) {
                                finalTarget = this.portalBNode;
                                baseReward = 0;
                                isPortal = true;
                            } else if (finalTarget.type === 'PORTAL_B' && this.portalANode !== null) {
                                finalTarget = this.portalANode;
                                baseReward = 0;
                                isPortal = true;
                            }

                            // Terminal destination reward overrides
                            if (finalTarget.type === 'GOAL') {
                                baseReward = 100;
                            } else if (finalTarget.type === 'TRAP') {
                                baseReward = -50;
                            }

                            node.addEdge(dir, finalTarget, baseReward, isPortal, isBoost);
                            if (!resetQ) {
                                const createdEdge = node.getEdge(dir);
                                if (createdEdge !== null) {
                                    createdEdge.qMap = savedQ[dir];
                                }
                            }
                        }
                    }
                }
            }

            resetAllQValues() {
                for (let r = 0; r < this.rows; r++) {
                    for (let c = 0; c < this.cols; c++) {
                        let edge = this.nodes[r][c].edgesHead;
                        while (edge !== null) {
                            edge.qMap = {};
                            edge = edge.next;
                        }
                    }
                }
            }

            /**
             * Pointer-based Breadth-First Search verifying Start -> Goal reachability.
             */
            checkPathExistsBFS() {
                if (this.startNode === null || this.goalNode === null) return false;

                const visited = new Array(this.rows);
                for (let r = 0; r < this.rows; r++) {
                    visited[r] = new Array(this.cols);
                    for (let c = 0; c < this.cols; c++) {
                        visited[r][c] = false;
                    }
                }

                const queue = new BFSQueue();
                queue.enqueue(this.startNode);
                visited[this.startNode.row][this.startNode.col] = true;

                while (!queue.isEmpty()) {
                    const curr = queue.dequeue();
                    if (curr === this.goalNode) return true;
                    if (curr.type === 'TRAP') continue;

                    let edge = curr.edgesHead;
                    while (edge !== null) {
                        const target = edge.targetNode;
                        if (target.type !== 'TRAP' && !visited[target.row][target.col]) {
                            visited[target.row][target.col] = true;
                            queue.enqueue(target);
                        }
                        edge = edge.next;
                    }
                }
                return false;
            }
        }

        /**
         * LINEAR DATA STRUCTURE 1: CircularReplayBuffer (Fixed Capacity = 10)
         * Pre-allocated circular array managed via head, tail, and count pointers.
         */
        class CircularReplayBuffer {
            constructor(capacity = 10) {
                this.capacity = capacity;
                this.slots = new Array(capacity);
                for (let i = 0; i < capacity; i++) {
                    this.slots[i] = null;
                }
                this.head = 0;
                this.tail = 0;
                this.count = 0;
                this.lastWrittenIndex = -1;
            }

            /**
             * Enqueues a transition record in O(1) time with circular wrap-around.
             */
            enqueue(record) {
                record.maskBefore = stepMaskBefore;
                record.maskAfter = curMaskKey;
                this.slots[this.tail] = record;
                this.lastWrittenIndex = this.tail;

                if (this.count === this.capacity) {
                    this.head = (this.head + 1) % this.capacity;
                } else {
                    this.count++;
                }

                this.tail = (this.tail + 1) % this.capacity;
            }

            /** Samples n stored AI transitions (uniform, with replacement) for experience replay. */
            sampleRecords(n) {
                const pool = [];
                for (let i = 0; i < this.capacity; i++) {
                    const r = this.slots[i];
                    if (r !== null && typeof r.episode === 'number') pool.push(r);
                }
                const out = [];
                if (pool.length === 0) return out;
                for (let k = 0; k < n; k++) out.push(pool[Math.floor(Math.random() * pool.length)]);
                return out;
            }

            clear() {
                for (let i = 0; i < this.capacity; i++) {
                    this.slots[i] = null;
                }
                this.head = 0;
                this.tail = 0;
                this.count = 0;
                this.lastWrittenIndex = -1;
            }
        }

        /**
         * LINEAR DATA STRUCTURE 2: TrajectoryStack (LIFO Singly-Linked List)
         */
        class StackNode {
            constructor(node, edge, reward, stepNum) {
                this.node = node;       // Origin GraphNode
                this.edge = edge;       // Traversed GraphEdge
                this.reward = reward;   // Actual reward received on this transition
                this.stepNum = stepNum; // Sequential step index
                this.next = null;       // Pointer to next StackNode below
            }
        }

        class TrajectoryStack {
            constructor() {
                this.top = null;
                this.size = 0;
            }

            /**
             * Pushes a transition onto the TOP of the stack in O(1) time.
             */
            push(node, edge, reward, stepNum) {
                const newNode = new StackNode(node, edge, reward, stepNum);
                newNode.maskBefore = stepMaskBefore;
                newNode.maskAfter = curMaskKey;
                newNode.next = this.top;
                this.top = newNode;
                this.size++;
                return newNode;
            }

            /**
             * Pops and returns the TOP StackNode in O(1) time for LIFO backpropagation.
             */
            pop() {
                if (this.top === null) return null;
                const popped = this.top;
                this.top = this.top.next;
                popped.next = null;
                this.size--;
                return popped;
            }

            clear() {
                while (this.top !== null) {
                    this.pop();
                }
            }
        }

        /* ============================================================================

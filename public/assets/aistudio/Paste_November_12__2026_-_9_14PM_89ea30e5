                        specialTag = '<span class="px-1.5 py-0.2 rounded text-[9px] border border-[#0A0A0A] bg-white text-[#0A0A0A]">WARP</span>';
                    } else if (edge.isBoost) {
                        specialTag = '<span class="px-1.5 py-0.2 rounded text-[9px] border border-[#0A0A0A] bg-white text-[#0A0A0A]">SLIDE</span>';
                    }

                    html += `
                        <div class="px-3.5 py-2.5 rounded-lg border ${isBest ? 'border-[#0A0A0A] bg-[#FAFAFA]' : 'border-[#E4E4E7] bg-white'} flex flex-col gap-1.5">
                            <div class="flex items-center justify-between font-mono text-xs gap-1">
                                <div class="flex items-center gap-1.5 min-w-0">
                                    <span class="font-bold text-[#0A0A0A]">${dir}</span>
                                    <span class="text-[#52525B]">→</span>
                                    <span class="text-[#0A0A0A]">(${edge.targetNode.row},${edge.targetNode.col})</span>
                                    ${specialTag}
                                    ${isBest ? '<span class="px-1.5 py-0.2 rounded text-[9px] font-semibold bg-[#0A0A0A] text-white">BEST</span>' : ''}
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <span class="text-[11px] text-[#52525B]">R:${rewStr}</span>
                                    <span class="font-bold text-[#0A0A0A]">Q:${edge.qValue.toFixed(2)}</span>
                                </div>
                            </div>
                            <div class="w-full h-1.5 rounded-full bg-[#E4E4E7] overflow-hidden">
                                <div class="h-full bg-[#0A0A0A] transition-all duration-150" style="width: ${barPct}%"></div>
                            </div>
                        </div>
                    `;
                }
            }

            listEl.innerHTML = html;
        }

        function updateReachabilityStatus() {
            const ok = graph.checkPathExistsBFS();
            const badge = document.getElementById('reachabilityBadge');
            const dot = document.getElementById('reachabilityDot');
            const text = document.getElementById('reachabilityText');

            if (ok) {
                badge.className = 'px-3.5 py-2 rounded-lg text-xs font-mono font-medium border border-[#0A0A0A] bg-[#FAFAFA] text-[#0A0A0A] flex items-center gap-2';
                dot.className = 'w-2 h-2 rounded-full bg-[#0A0A0A]';
                text.textContent = 'BFS Path: Verified';
            } else {
                badge.className = 'px-3.5 py-2 rounded-lg text-xs font-mono font-semibold border border-[#0A0A0A] bg-[#0A0A0A] text-white flex items-center gap-2';
                dot.className = 'w-2 h-2 rounded-full bg-white';
                text.textContent = 'BFS Path: Blocked!';
            }
        }

        function renderLearningCurve() {
            const cv = document.getElementById('lcCanvas');
            if (!cv) return;
            const dpr = window.devicePixelRatio || 1;
            const W = cv.clientWidth, H = cv.clientHeight;
            if (W === 0) return;
            cv.width = W * dpr; cv.height = H * dpr;
            const g = cv.getContext('2d');
            g.setTransform(dpr, 0, 0, dpr, 0, 0);
            g.clearRect(0, 0, W, H);
            const pad = 6, h = appState.history, n = h.length;
            g.strokeStyle = '#E4E4E7'; g.lineWidth = 1; g.fillStyle = '#A1A1AA'; g.font = '10px JetBrains Mono, monospace';
            for (let i = 0; i <= 2; i++) {
                const y = pad + (H - 2 * pad) * (1 - i / 2);
                g.beginPath(); g.moveTo(0, y); g.lineTo(W, y); g.stroke();
                g.fillText(['0%', '50%', '100%'][i], 2, y - 2);
            }
            if (n < 2) { g.fillStyle = '#52525B'; g.fillText('Train episodes to see the learning curve', W / 2 - 100, H / 2); return; }
            const win = 25, wr = [], rw = [];
            let sw = 0, sr = 0;
            for (let i = 0; i < n; i++) {
                sw += h[i].w; sr += h[i].r;
                if (i >= win) { sw -= h[i - win].w; sr -= h[i - win].r; }
                const d = Math.min(i + 1, win);
                wr.push(sw / d); rw.push(sr / d);
            }
            let mn = Infinity, mx = -Infinity;
            for (let i = 0; i < n; i++) { if (rw[i] < mn) mn = rw[i]; if (rw[i] > mx) mx = rw[i]; }
            if (mx - mn < 1e-6) mx = mn + 1;
            const X = i => pad + (W - 2 * pad) * (i / (n - 1));
            const line = (arr, norm, color, dash) => {
                g.beginPath(); g.setLineDash(dash); g.strokeStyle = color; g.lineWidth = 1.75;
                for (let i = 0; i < n; i++) {
                    const y = pad + (H - 2 * pad) * (1 - norm(arr[i]));
                    if (i === 0) g.moveTo(X(i), y); else g.lineTo(X(i), y);
                }
                g.stroke(); g.setLineDash([]);
            };
            line(rw, v => (v - mn) / (mx - mn), '#A1A1AA', [4, 3]);
            line(wr, v => v, '#0A0A0A', []);
        }

        function exportMap() {
            const tiles = graph.nodes.map(row => row.map(nd => nd.type === 'BOOST' ? 'BOOST:' + nd.boostDir : nd.type));
            const blob = new Blob([JSON.stringify({ app: 'gridworld-gym', version: 1, size: GRID_SIZE, tiles }, null, 1)], { type: 'application/json' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'gridworld-map.json';
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(a.href), 1000);
            showToast('Map exported as gridworld-map.json');
        }

        function importMapFromText(text) {
            const types = ['EMPTY', 'WALL', 'START', 'GOAL', 'TRAP', 'BOOST', 'PORTAL_A', 'PORTAL_B', 'BONUS'];
            try {
                const d = JSON.parse(text);
                if (!d || !Array.isArray(d.tiles) || d.tiles.length !== GRID_SIZE) throw new Error('size');
                let starts = 0, goals = 0, sPos = null, gPos = null;
                for (let r = 0; r < GRID_SIZE; r++) {
                    if (!Array.isArray(d.tiles[r]) || d.tiles[r].length !== GRID_SIZE) throw new Error('size');
                    for (let c = 0; c < GRID_SIZE; c++) {
                        const parts = String(d.tiles[r][c]).split(':');
                        if (types.indexOf(parts[0]) < 0) throw new Error('type');
                        if (parts[0] === 'START') { starts++; sPos = [r, c]; }
                        if (parts[0] === 'GOAL') { goals++; gPos = [r, c]; }
                    }
                }
                if (starts !== 1 || goals !== 1) throw new Error('start/goal');
                stopAllTimers();
                clearBoardNodes();
                for (let r = 0; r < GRID_SIZE; r++) {
                    for (let c = 0; c < GRID_SIZE; c++) {
                        const parts = String(d.tiles[r][c]).split(':');
                        graph.nodes[r][c].type = parts[0];
                        if (parts[0] === 'BOOST' && BOOST_CYCLE.indexOf(parts[1]) >= 0) graph.nodes[r][c].boostDir = parts[1];
                    }
                }
                graph.startNode = graph.nodes[sPos[0]][sPos[1]];
                graph.goalNode = graph.nodes[gPos[0]][gPos[1]];
                graph.rebuildEdges(true);
                resetBrainState(false);
                updateReachabilityStatus();
                renderAll();
                showToast('Map imported.');
            } catch (err) {
                showToast('Invalid map file.');
            }
        }

        function renderAll() {
            drawArena();
            renderTelemetryCards();
            renderCircularReplayBufferUI();
            renderTrajectoryStackUI();
            renderGraphInspectorUI();
            renderLearningCurve();
        }

        /* ============================================================================
           SECTION 10: TOAST BANNER & MODAL CONTROLLERS
           ============================================================================ */

        function showToast(message) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'animate-entry px-4 py-3 rounded-lg border border-[#0A0A0A] bg-[#0A0A0A] text-white text-xs font-medium shadow-md';
            toast.textContent = message;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.2s ease';
                setTimeout(() => toast.remove(), 220);
            }, 2800);
        }

        let activeCodeTab = 'graph';
        function openCodeModal(tabKey = 'graph') {
            activeCodeTab = tabKey;
            document.getElementById('dsaCodeDisplay').textContent = DSA_CODE_TABS[tabKey];

            const tabs = document.querySelectorAll('.code-tab-btn');
            for (let i = 0; i < tabs.length; i++) {
                const t = tabs[i];
                const isSelected = t.dataset.codetab === tabKey;
                t.className = isSelected
                    ? 'code-tab-btn px-3.5 py-2 rounded-t-lg text-xs font-mono font-semibold bg-white text-[#0A0A0A] border-t border-x border-[#0A0A0A] -mb-px cursor-pointer'
                    : 'code-tab-btn px-3.5 py-2 rounded-t-lg text-xs font-mono font-medium text-[#52525B] hover:text-[#0A0A0A] cursor-pointer';
            }

            const modal = document.getElementById('codeModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        /* ============================================================================
           SECTION 11: EVENT LISTENERS & INITIALIZATION
           ============================================================================ */

        function setupEventListeners() {
            // Canvas Mouse Interaction
            canvas.addEventListener('mousedown', (e) => {
                const node = getCellFromPointerEvent(e);
                if (node === null) return;

                if (appState.boardMode === 'EDIT') {
                    appState.isPointerDown = true;
                    paintTileWithBrush(node, true);
                } else {
                    appState.inspectedNode = node;
                    drawArena();
                    renderGraphInspectorUI();
                }
            });

            canvas.addEventListener('mousemove', (e) => {
                const node = getCellFromPointerEvent(e);
                if (node === null) return;

                if (appState.boardMode === 'EDIT' && appState.isPointerDown) {
                    paintTileWithBrush(node, false);
                } else if (!appState.isAnimatingSingle && appState.inspectedNode !== node) {
                    appState.inspectedNode = node;
                    drawArena();
                    renderGraphInspectorUI();
                }
            });

            window.addEventListener('mouseup', () => {
                appState.isPointerDown = false;
            });

            // Canvas Touch Interaction (Mobile Scroll-Safe in Inspect Mode!)
            canvas.addEventListener('touchstart', (e) => {
                const node = getCellFromPointerEvent(e);
                if (node === null) return;

                if (appState.boardMode === 'EDIT') {
                    e.preventDefault();
                    appState.isPointerDown = true;
                    paintTileWithBrush(node, true);
                } else {
                    appState.inspectedNode = node;
                    drawArena();
                    renderGraphInspectorUI();
                }
            }, { passive: false });

            canvas.addEventListener('touchmove', (e) => {
                if (appState.boardMode === 'EDIT' && appState.isPointerDown) {
                    e.preventDefault();
                    const node = getCellFromPointerEvent(e);
                    if (node !== null) paintTileWithBrush(node, false);
                }
            }, { passive: false });

            canvas.addEventListener('touchend', () => {
                appState.isPointerDown = false;
            });

            // 3-Mode Segmented Toggle
            const modeBtns = document.querySelectorAll('.board-mode-btn');
            for (let i = 0; i < modeBtns.length; i++) {
                modeBtns[i].addEventListener('click', () => {
                    setBoardMode(modeBtns[i].dataset.boardmode);
                });
            }

            // Tile Brush Buttons
            const brushBtns = document.querySelectorAll('.brush-btn');
            for (let i = 0; i < brushBtns.length; i++) {
                brushBtns[i].addEventListener('click', () => {
                    const clickedBrush = brushBtns[i].dataset.brush;

                    if (clickedBrush === 'BOOST' && appState.activeBrush === 'BOOST') {
                        let nextIdx = 0;
                        for (let j = 0; j < 4; j++) {
                            if (BOOST_CYCLE[j] === appState.brushBoostDir) {
                                nextIdx = (j + 1) % 4;
                                break;
                            }
                        }
                        appState.brushBoostDir = BOOST_CYCLE[nextIdx];
                        updateBoostBrushUI();
                    }

                    appState.activeBrush = clickedBrush;
                    for (let k = 0; k < brushBtns.length; k++) {
                        const active = brushBtns[k].dataset.brush === clickedBrush;
                        brushBtns[k].className = active
                            ? 'brush-btn flex items-center gap-2 px-2.5 py-2.5 rounded-lg text-xs font-semibold bg-[#0A0A0A] text-white border border-[#0A0A0A] transition cursor-pointer'
                            : 'brush-btn flex items-center gap-2 px-2.5 py-2.5 rounded-lg text-xs font-medium bg-white text-[#0A0A0A] border border-[#E4E4E7] hover:border-[#0A0A0A] transition cursor-pointer';
                    }
                });
            }

            // Preset Arena Buttons
            const presetBtns = document.querySelectorAll('.preset-btn');
            for (let i = 0; i < presetBtns.length; i++) {
                presetBtns[i].addEventListener('click', () => {
                    const chosen = presetBtns[i].dataset.preset;
                    for (let j = 0; j < presetBtns.length; j++) {
                        presetBtns[j].className = presetBtns[j].dataset.preset === chosen
                            ? 'preset-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#0A0A0A] text-white border border-[#0A0A0A] transition cursor-pointer'
                            : 'preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-white hover:bg-[#F4F4F5] text-[#0A0A0A] border border-[#E4E4E7] transition cursor-pointer';
                    }
                    loadPreset(chosen);
                });
            }

            // Procedural Map Generator
            document.getElementById('btnRandomizeMap').addEventListener('click', generateRandomSolvableMap);

            // D-Pad & Keyboard Controls for Manual Play
            const dpadBtns = document.querySelectorAll('.dpad-btn');
            for (let i = 0; i < dpadBtns.length; i++) {
                dpadBtns[i].addEventListener('click', () => {
                    moveHumanAgent(dpadBtns[i].dataset.dpad);
                });
            }

            document.getElementById('btnResetManualRun').addEventListener('click', () => {
                resetManualRunState(true);
            });

            window.addEventListener('keydown', (e) => {
                if (appState.boardMode !== 'PLAY') return;
                const keyMap = {
                    ArrowUp: 'UP', w: 'UP', W: 'UP',
                    ArrowDown: 'DOWN', s: 'DOWN', S: 'DOWN',
                    ArrowLeft: 'LEFT', a: 'LEFT', A: 'LEFT',
                    ArrowRight: 'RIGHT', d: 'RIGHT', D: 'RIGHT'
                };
                if (keyMap[e.key]) {
                    e.preventDefault();
                    moveHumanAgent(keyMap[e.key]);
                }
            });

            // Overlay Toggles
            document.getElementById('toggleHeatmap').addEventListener('change', drawArena);
            document.getElementById('toggleArrows').addEventListener('change', drawArena);

            // RL Training Buttons
            document.getElementById('btnWatchEpisode').addEventListener('click', () => startAnimatedEpisode(false));
            document.getElementById('btnTrain100').addEventListener('click', trainBatch100Episodes);
            document.getElementById('btnAutoTrain').addEventListener('click', toggleAutoTrain);
            document.getElementById('btnOptimalRun').addEventListener('click', () => startAnimatedEpisode(true));
            document.getElementById('btnResetBrain').addEventListener('click', () => resetBrainState(true));

            // Speed Slider
            document.getElementById('speedSlider').addEventListener('input', (e) => {
                appState.speedPercent = parseInt(e.target.value, 10);
                document.getElementById('speedValue').textContent = `${appState.speedPercent}%`;
            });

            // Modals
            document.getElementById('btnViewCode').addEventListener('click', () => openCodeModal(activeCodeTab));
            document.getElementById('btnCloseCodeModal').addEventListener('click', () => {
                const modal = document.getElementById('codeModal');
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            });

            const codeTabBtns = document.querySelectorAll('.code-tab-btn');
            for (let i = 0; i < codeTabBtns.length; i++) {
                codeTabBtns[i].addEventListener('click', () => {
                    openCodeModal(codeTabBtns[i].dataset.codetab);
                });
            }

            document.getElementById('btnCopyCode').addEventListener('click', () => {
                const temp = document.createElement('textarea');
                temp.value = DSA_CODE_TABS[activeCodeTab];
                document.body.appendChild(temp);
                temp.select();
                document.execCommand('copy');
                document.body.removeChild(temp);
                showToast('DSA code copied to clipboard.');
            });

            document.getElementById('btnHowItWorks').addEventListener('click', () => {
                const modal = document.getElementById('helpModal');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            });

            document.getElementById('btnCloseHelpModal').addEventListener('click', () => {
                const modal = document.getElementById('helpModal');
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            });

            const modals = [document.getElementById('codeModal'), document.getElementById('helpModal')];
            for (let i = 0; i < modals.length; i++) {
                modals[i].addEventListener('click', (e) => {
                    if (e.target === modals[i]) {
                        modals[i].classList.add('hidden');
                        modals[i].classList.remove('flex');
                    }
                });
            }

            // Hyperparameter sliders + experience replay toggle
            const bindSlider = (id, valId, key, fmt) => {
                document.getElementById(id).addEventListener('input', (e) => {
                    appState[key] = parseFloat(e.target.value);
                    document.getElementById(valId).textContent = fmt(appState[key]);
                });
            };
            bindSlider('sliderAlpha', 'valAlpha', 'alpha', v => v.toFixed(2));
            bindSlider('sliderGamma', 'valGamma', 'gamma', v => v.toFixed(2));
            bindSlider('sliderDecay', 'valDecay', 'epsilonDecay', v => v.toFixed(3));
            document.getElementById('toggleReplay').addEventListener('change', (e) => {
                appState.replayOn = e.target.checked;
            });

            // Map save / load
            document.getElementById('btnExportMap').addEventListener('click', exportMap);
            document.getElementById('btnImportMap').addEventListener('click', () => document.getElementById('mapFileInput').click());
            document.getElementById('mapFileInput').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = () => importMapFromText(String(reader.result));
                reader.readAsText(file);
                e.target.value = '';
            });

            // Esc closes any open modal
            window.addEventListener('keydown', (e) => {
                if (e.key !== 'Escape') return;
                for (let i = 0; i < modals.length; i++) {
                    modals[i].classList.add('hidden');
                    modals[i].classList.remove('flex');
                }
            });

            window.addEventListener('resize', () => { resizeCanvas(); renderLearningCurve(); });
        }

        window.onload = function () {
            setupEventListeners();
            loadPreset('default');
            resizeCanvas();
        };
    </script>
</body>

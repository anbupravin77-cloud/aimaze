                let boostsPlaced = 0;
                while (boostsPlaced < 2) {
                    const r = Math.floor(Math.random() * GRID_SIZE);
                    const c = Math.floor(Math.random() * GRID_SIZE);
                    if (graph.nodes[r][c].type === 'EMPTY') {
                        graph.nodes[r][c].type = 'BOOST';
                        graph.nodes[r][c].boostDir = BOOST_CYCLE[Math.floor(Math.random() * 4)];
                        boostsPlaced++;
                    }
                }

                // Place Paired Portals A and B
                let portalAPlaced = false;
                while (!portalAPlaced) {
                    const r = Math.floor(Math.random() * 5);
                    const c = Math.floor(Math.random() * 5);
                    if (graph.nodes[r][c].type === 'EMPTY') {
                        graph.nodes[r][c].type = 'PORTAL_A';
                        portalAPlaced = true;
                    }
                }
                let portalBPlaced = false;
                while (!portalBPlaced) {
                    const r = 5 + Math.floor(Math.random() * 5);
                    const c = 5 + Math.floor(Math.random() * 5);
                    if (graph.nodes[r][c].type === 'EMPTY') {
                        graph.nodes[r][c].type = 'PORTAL_B';
                        portalBPlaced = true;
                    }
                }

                // Place 1 Bonus Beacon (+25)
                let bonusPlaced = false;
                while (!bonusPlaced) {
                    const r = Math.floor(Math.random() * GRID_SIZE);
                    const c = Math.floor(Math.random() * GRID_SIZE);
                    if (graph.nodes[r][c].type === 'EMPTY') {
                        graph.nodes[r][c].type = 'BONUS';
                        bonusPlaced = true;
                    }
                }

                graph.rebuildEdges(true);
                solvable = graph.checkPathExistsBFS();
            }

            // Clear active preset highlight
            const presetBtns = document.querySelectorAll('.preset-btn');
            for (let i = 0; i < presetBtns.length; i++) {
                presetBtns[i].className = 'preset-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-white hover:bg-[#F4F4F5] text-[#0A0A0A] border border-[#E4E4E7] transition cursor-pointer';
            }

            resetBrainState(false);
            updateReachabilityStatus();
            renderAll();
            showToast('Generated new BFS-verified solvable arena.');
        }

        function resetBrainState(showFeedback = true) {
            stopAllTimers();
            graph.resetAllQValues();
            replayBuffer.clear();
            trajectoryStack.clear();
            resetEpisodeBonuses();

            appState.episode = 0;
            appState.history = [];
            appState.totalWins = 0;
            appState.lastReward = 0;
            appState.lastOutcome = 'Awaiting run';
            appState.epsilon = 1.0;
            appState.agentNode = graph.startNode;
            appState.inspectedNode = graph.startNode;
            appState.activeBackpropEdge = null;
            appState.stackStatus = 'IDLE';
            appState.phaseText = 'READY • SELECT TRAIN OR WATCH EPISODE';

            resetManualRunState(false);
            renderAll();
            if (showFeedback) {
                showToast('AI Brain reset: Q-values, Stack, and Ring Buffer cleared.');
            }
        }

        /* ============================================================================
           SECTION 5: TABULAR Q-LEARNING ENGINE & LIFO STACK BACKPROPAGATION
           ============================================================================ */

        /**
         * Selects an outgoing GraphEdge using Epsilon-Greedy policy.
         */
        function chooseActionEdge(node, epsilonOverride = null) {
            if (node.edgesHead === null) return null;
            const eps = epsilonOverride !== null ? epsilonOverride : appState.epsilon;

            if (Math.random() < eps) {
                let count = 0;
                let curr = node.edgesHead;
                while (curr !== null) {
                    count++;
                    curr = curr.next;
                }
                const targetIdx = Math.floor(Math.random() * count);
                let idx = 0;
                curr = node.edgesHead;
                while (curr !== null) {
                    if (idx === targetIdx) return curr;
                    idx++;
                    curr = curr.next;
                }
            }
            return node.getBestEdge();
        }

        /**
         * Computes immediate transition reward, awarding +25 once per episode on BONUS tiles.
         */
        function evaluateStepReward(edge) {
            let reward = edge.baseReward;
            const dest = edge.targetNode;
            stepMaskBefore = curMaskKey;
            if (dest.type === 'BONUS' && !collectedBonus[dest.row][dest.col]) {
                collectedBonus[dest.row][dest.col] = true;
                collectedList.push(dest.row * GRID_SIZE + dest.col);
                curMaskKey = collectedList.slice().sort((a, b) => a - b).join('|');
                reward = 25;
            }
            return reward;
        }

        /**
         * Bellman Q-Learning Update executed as each StackNode is popped LIFO.
         */
        function updateQValueFromStackNode(stackNode) {
            const edge = stackNode.edge;
            if (edge === null) return;

            applyTD(edge, stackNode.reward, stackNode.maskBefore, stackNode.maskAfter);
        }

        /** One Bellman update: Q(s,a) += α (r + γ max Q(s',·) − Q(s,a)), with s = tile + bonus state. */
        function applyTD(edge, reward, maskBefore, maskAfter) {
            const saved = curMaskKey;
            const dest = edge.targetNode;
            const isTerminal = (dest.type === 'GOAL' || dest.type === 'TRAP');
            curMaskKey = maskAfter;
            const maxNextQ = isTerminal ? 0.0 : dest.getMaxQ();
            curMaskKey = maskBefore;
            edge.qValue = edge.qValue + appState.alpha * (reward + appState.gamma * maxNextQ - edge.qValue);
            curMaskKey = saved;
        }

        /** Experience replay: re-learns from random transitions stored in the CircularReplayBuffer. */
        function replayUpdates() {
            if (!appState.replayOn) return;
            const recs = replayBuffer.sampleRecords(appState.replayBatch);
            for (let i = 0; i < recs.length; i++) {
                const rec = recs[i];
                const edge = graph.nodes[rec.fromRow][rec.fromCol].getEdge(rec.action);
                if (edge !== null) applyTD(edge, rec.reward, rec.maskBefore, rec.maskAfter);
            }
        }

        function recordEpisode(reward, won) {
            appState.history.push({ r: reward, w: won ? 1 : 0 });
            if (appState.history.length > 1000) appState.history.shift();
        }

        /**
         * Executes 1 fast headless training episode.
         */
        function runSingleFastEpisode() {
            trajectoryStack.clear();
            resetEpisodeBonuses();

            let currNode = graph.startNode;
            let totalReward = 0;
            let steps = 0;
            let outcome = 'Max Steps';

            while (steps < MAX_EPISODE_STEPS) {
                if (currNode.type === 'GOAL' || currNode.type === 'TRAP') break;

                const chosenEdge = chooseActionEdge(currNode);
                if (chosenEdge === null) break;

                steps++;
                const reward = evaluateStepReward(chosenEdge);
                const nextNode = chosenEdge.targetNode;
                totalReward += reward;

                // Push transition onto Linear LIFO TrajectoryStack
                trajectoryStack.push(currNode, chosenEdge, reward, steps);

                // Enqueue transition into Linear CircularReplayBuffer
                replayBuffer.enqueue({
                    fromRow: currNode.row,
                    fromCol: currNode.col,
                    action: chosenEdge.dir,
                    toRow: nextNode.row,
                    toCol: nextNode.col,
                    reward: reward,
                    episode: appState.episode + 1
                });

                currNode = nextNode;
            }

            if (currNode.type === 'GOAL') {
                outcome = 'Goal Reached (+100)';
                appState.totalWins++;
            } else if (currNode.type === 'TRAP') {
                outcome = 'Hazard Trap (-50)';
            }

            // Pop TrajectoryStack LIFO to backpropagate rewards
            while (trajectoryStack.top !== null) {
                const popped = trajectoryStack.pop();
                updateQValueFromStackNode(popped);
            }

            curMaskKey = '';
            replayUpdates();
            recordEpisode(totalReward, currNode.type === 'GOAL');
            appState.episode++;
            appState.lastReward = totalReward;
            appState.lastOutcome = outcome;
            appState.agentNode = currNode;
            appState.epsilon = Math.max(appState.minEpsilon, appState.epsilon * appState.epsilonDecay);
        }

        /**
         * Animated 1-Episode Visualizer (Phase 1: Push Forward -> Phase 2: Pop LIFO Backward)
         */
        function startAnimatedEpisode(isOptimalRun = false) {
            if (!graph.checkPathExistsBFS()) {
                showToast('Goal is blocked! Edit walls or randomize map first.');
                return;
            }

            stopAllTimers();
            if (appState.boardMode === 'PLAY') {
                setBoardMode('INSPECT');
            }

            appState.isAnimatingSingle = true;
            trajectoryStack.clear();
            resetEpisodeBonuses();

            let currNode = graph.startNode;
            appState.agentNode = currNode;
            let steps = 0;
            let totalReward = 0;
            const stepCap = isOptimalRun ? 50 : MAX_EPISODE_STEPS;

            appState.stackStatus = 'PUSHING';
            appState.phaseText = isOptimalRun
                ? 'OPTIMAL POLICY • GREEDY EXECUTION (ε = 0%)'
                : 'PHASE 1 • PUSHING STEPS TO TRAJECTORY STACK';
            renderAll();

            const getStepInterval = () => Math.max(30, 320 - appState.speedPercent * 2.8);

            function forwardStep() {
                if (!appState.isAnimatingSingle) return;

                if (currNode.type === 'GOAL' || currNode.type === 'TRAP' || steps >= stepCap || currNode.edgesHead === null) {
                    if (currNode.type === 'GOAL') {
                        appState.lastOutcome = 'Goal Reached (+100)';
                        if (!isOptimalRun) appState.totalWins++;
                    } else if (currNode.type === 'TRAP') {
                        appState.lastOutcome = 'Hazard Trap (-50)';
                    } else {
                        appState.lastOutcome = 'Max Steps Limit';
                    }

                    appState.lastReward = totalReward;
                    if (!isOptimalRun) {
                        recordEpisode(totalReward, currNode.type === 'GOAL');
                        appState.episode++;
                        appState.epsilon = Math.max(appState.minEpsilon, appState.epsilon * appState.epsilonDecay);
                    }

                    startBackpropPopPhase(isOptimalRun);
                    return;
                }

                const chosenEdge = chooseActionEdge(currNode, isOptimalRun ? 0.0 : appState.epsilon);
                if (chosenEdge === null) {
                    startBackpropPopPhase(isOptimalRun);
                    return;
                }

                steps++;
                const reward = evaluateStepReward(chosenEdge);
                const nextNode = chosenEdge.targetNode;
                totalReward += reward;

                trajectoryStack.push(currNode, chosenEdge, reward, steps);
                replayBuffer.enqueue({
                    fromRow: currNode.row,
                    fromCol: currNode.col,
                    action: chosenEdge.dir,
                    toRow: nextNode.row,
                    toCol: nextNode.col,
                    reward: reward,
                    episode: isOptimalRun ? 'OPT' : appState.episode + 1
                });

                currNode = nextNode;
                appState.agentNode = currNode;
                appState.inspectedNode = currNode;

                renderAll();
                appState.animTimer = setTimeout(forwardStep, getStepInterval());
            }

            appState.animTimer = setTimeout(forwardStep, getStepInterval());
        }

        function startBackpropPopPhase(isOptimalRun) {
            appState.stackStatus = 'POPPING';
            curMaskKey = '';
            appState.phaseText = isOptimalRun
                ? 'OPTIMAL RUN DONE • UNWINDING TRAJECTORY STACK'
                : 'PHASE 2 • POPPING STACK (LIFO) & UPDATING Q-VALUES';
            renderAll();

            const getPopInterval = () => Math.max(30, 280 - appState.speedPercent * 2.4);

            function popStep() {
                if (!appState.isAnimatingSingle) return;

                if (trajectoryStack.top === null) {
                    if (!isOptimalRun) replayUpdates();
                    curMaskKey = '';
                    appState.isAnimatingSingle = false;
                    appState.stackStatus = 'IDLE';
                    appState.activeBackpropEdge = null;
                    appState.phaseText = 'EPISODE COMPLETE • Q-VALUES UPDATED';
                    renderAll();
                    return;
                }

                const popped = trajectoryStack.pop();
                if (!isOptimalRun) {
                    updateQValueFromStackNode(popped);
                }

                appState.activeBackpropEdge = {
                    fromNode: popped.node,
                    toNode: popped.edge.targetNode
                };
                appState.inspectedNode = popped.node;

                renderAll();
                appState.animTimer = setTimeout(popStep, getPopInterval());
            }

            appState.animTimer = setTimeout(popStep, getPopInterval());
        }

        function trainBatch100Episodes() {
            if (!graph.checkPathExistsBFS()) {
                showToast('Goal is blocked! Edit walls or randomize map first.');
                return;
            }
            stopAllTimers();
            if (appState.boardMode === 'PLAY') {
                setBoardMode('INSPECT');
            }

            for (let i = 0; i < 100; i++) {
                runSingleFastEpisode();
            }

            appState.stackStatus = 'IDLE';
            appState.activeBackpropEdge = null;
            appState.phaseText = `TRAINED 100 EPISODES • TOTAL: ${appState.episode}`;
            renderAll();
            showToast(`Trained 100 episodes. Goal win rate: ${formatWinRate()}`);
        }

        function toggleAutoTrain() {
            if (appState.isAutoTraining) {
                stopAllTimers();
                appState.phaseText = 'AUTO-TRAIN PAUSED';
                renderAll();
                return;
            }

            if (!graph.checkPathExistsBFS()) {
                showToast('Goal is blocked! Edit walls or randomize map first.');
                return;
            }

            stopAllTimers();
            if (appState.boardMode === 'PLAY') {
                setBoardMode('INSPECT');
            }

            appState.isAutoTraining = true;
            updateAutoTrainUI();

            const loop = () => {
                if (!appState.isAutoTraining) return;
                const batchSize = appState.speedPercent > 75 ? 6 : (appState.speedPercent > 40 ? 2 : 1);
                for (let i = 0; i < batchSize; i++) {
                    runSingleFastEpisode();
                }
                appState.phaseText = `AUTO-TRAINING • EPISODE ${appState.episode}`;
                renderAll();

                const delay = Math.max(16, 170 - appState.speedPercent * 1.5);
                appState.autoTimer = setTimeout(loop, delay);
            };
            loop();
        }

        function stopAllTimers() {
            appState.isAnimatingSingle = false;
            appState.isAutoTraining = false;
            appState.activeBackpropEdge = null;
            if (appState.animTimer !== null) {
                clearTimeout(appState.animTimer);
                appState.animTimer = null;
            }
            if (appState.autoTimer !== null) {
                clearTimeout(appState.autoTimer);
                appState.autoTimer = null;
            }
            updateAutoTrainUI();
        }

        function updateAutoTrainUI() {
            const btn = document.getElementById('btnAutoTrain');
            const dot = document.getElementById('autoTrainDot');
            const lbl = document.getElementById('autoTrainLabel');
            if (appState.isAutoTraining) {
                btn.className = 'col-span-2 sm:col-span-1 px-3 py-2.5 rounded-lg text-xs font-semibold bg-[#0A0A0A] text-white border border-[#0A0A0A] transition flex items-center justify-center gap-2 cursor-pointer';
                dot.className = 'w-2 h-2 rounded-full bg-white animate-ping';
                lbl.textContent = 'Auto-Train: ON';
            } else {
                btn.className = 'col-span-2 sm:col-span-1 px-3 py-2.5 rounded-lg text-xs font-semibold bg-white hover:bg-[#F4F4F5] text-[#0A0A0A] border border-[#0A0A0A] transition flex items-center justify-center gap-2 cursor-pointer';
                dot.className = 'w-2 h-2 rounded-full border border-[#0A0A0A] bg-white';
                lbl.textContent = 'Auto-Train: OFF';
            }
        }

        /* ============================================================================
           SECTION 6: MANUAL PLAY MODE & HUMAN VS AI BENCHMARK
           ============================================================================ */

        /**
         * Computes the current trained AI's greedy optimal score from Start -> Goal
         * so Human players can compare their score directly against the AI.
         */
        function computeAIOptimalBenchmark() {
            if (appState.episode === 0 || !graph.checkPathExistsBFS()) return null;

            const savedBonuses = new Array(GRID_SIZE);
            for (let r = 0; r < GRID_SIZE; r++) {
                savedBonuses[r] = new Array(GRID_SIZE);
                for (let c = 0; c < GRID_SIZE; c++) {
                    savedBonuses[r][c] = collectedBonus[r][c];
                    collectedBonus[r][c] = false;
                }
            }

            const savedMaskKey = curMaskKey, savedList = collectedList;
            curMaskKey = ''; collectedList = [];
            let curr = graph.startNode;
            let score = 0;
            let steps = 0;
            let reachedGoal = false;

            while (steps < 45) {
                if (curr === graph.goalNode) {
                    reachedGoal = true;
                    break;
                }
                if (curr.type === 'TRAP') break;

                const bestEdge = curr.getBestEdge();
                if (bestEdge === null || Math.abs(bestEdge.qValue) < 0.01) break;

                steps++;
                score += evaluateStepReward(bestEdge);
                curr = bestEdge.targetNode;
            }

            for (let r = 0; r < GRID_SIZE; r++) {
                for (let c = 0; c < GRID_SIZE; c++) {
                    collectedBonus[r][c] = savedBonuses[r][c];
                }
            }

            curMaskKey = savedMaskKey; collectedList = savedList;
            return reachedGoal ? score : null;
        }

        function resetManualRunState(shouldRender = true) {
            resetEpisodeBonuses();
            trajectoryStack.clear();
            appState.agentNode = graph.startNode;
            appState.inspectedNode = graph.startNode;
            appState.humanSteps = 0;
            appState.humanScore = 0;
            appState.humanFinished = false;
            appState.stackStatus = 'IDLE';

            if (appState.boardMode === 'PLAY') {
                appState.phaseText = 'MANUAL PLAY • USE ARROW KEYS OR D-PAD';
            }
            if (shouldRender) renderAll();
        }

        function moveHumanAgent(dir) {
            if (appState.boardMode !== 'PLAY') return;
            if (appState.humanFinished) {
                showToast('Run finished! Click "Reset Run" to play again.');
                return;
            }

            const curr = appState.agentNode;
            const edge = curr.getEdge(dir);
            if (edge === null) {
                showToast('Blocked by wall or arena boundary.');
                return;
            }

            appState.humanSteps++;
            const reward = evaluateStepReward(edge);
            appState.humanScore += reward;
            const nextNode = edge.targetNode;

            trajectoryStack.push(curr, edge, reward, appState.humanSteps);
            replayBuffer.enqueue({
                fromRow: curr.row,
                fromCol: curr.col,
                action: edge.dir,
                toRow: nextNode.row,
                toCol: nextNode.col,
                reward: reward,
                episode: 'MAN'
            });

            appState.agentNode = nextNode;
            appState.inspectedNode = nextNode;

            if (nextNode.type === 'GOAL') {
                appState.humanFinished = true;
                appState.phaseText = `GOAL REACHED IN ${appState.humanSteps} STEPS • SCORE: ${appState.humanScore}`;
                showToast(`Goal reached! Score: ${appState.humanScore} (${appState.humanSteps} steps)`);
            } else if (nextNode.type === 'TRAP') {
                appState.humanFinished = true;
                appState.phaseText = `HIT HAZARD TRAP (-50) • SCORE: ${appState.humanScore}`;
                showToast('You hit a Hazard Trap (-50)! Click Reset Run.');
            } else {
                appState.phaseText = `MANUAL PLAY • STEPS: ${appState.humanSteps} | SCORE: ${appState.humanScore}`;
            }

            renderAll();
        }

        function setBoardMode(newMode) {
            stopAllTimers();
            appState.boardMode = newMode;

            const modeBtns = document.querySelectorAll('.board-mode-btn');
            for (let i = 0; i < modeBtns.length; i++) {
                const btn = modeBtns[i];
                const isActive = btn.dataset.boardmode === newMode;
                btn.className = isActive
                    ? 'board-mode-btn py-2.5 px-2 rounded-lg text-xs font-semibold bg-[#0A0A0A] text-white transition cursor-pointer'
                    : 'board-mode-btn py-2.5 px-2 rounded-lg text-xs font-medium text-[#52525B] hover:text-[#0A0A0A] transition cursor-pointer';
            }

            const editPanel = document.getElementById('editPalettePanel');
            const playPanel = document.getElementById('manualPlayPanel');
            const subtitle = document.getElementById('modeSubtitle');
            const canvasEl = document.getElementById('gridCanvas');

            editPanel.classList.add('hidden');
            editPanel.classList.remove('flex');
            playPanel.classList.add('hidden');
            playPanel.classList.remove('flex');
            canvasEl.classList.remove('mode-edit', 'mode-play');

            if (newMode === 'INSPECT') {
                subtitle.textContent = 'Inspect Mode: Tap any tile to inspect its GraphNode & edges';
                appState.phaseText = 'INSPECT MODE • TAP ANY TILE TO VIEW GRAPH EDGES';
            } else if (newMode === 'EDIT') {
                editPanel.classList.remove('hidden');
                editPanel.classList.add('flex');
                canvasEl.classList.add('mode-edit');
                subtitle.textContent = 'Edit Mode: Tap or drag on the grid to place special tiles';
                appState.phaseText = 'EDIT ARENA • GRAPH EDGES UPDATE IN REAL TIME';
            } else if (newMode === 'PLAY') {
                playPanel.classList.remove('hidden');
                playPanel.classList.add('flex');
                canvasEl.classList.add('mode-play');
                subtitle.textContent = 'Manual Play: Navigate from Start (S) to Goal (G) vs AI';
                resetManualRunState(false);
            }

            renderAll();
        }

        /* ============================================================================
           SECTION 7: MONOCHROME SWISS ARCHITECTURAL CANVAS RENDERING
           ============================================================================ */
        const canvas = document.getElementById('gridCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            const container = canvas.parentElement;
            const rect = container.getBoundingClientRect();
            const size = Math.floor(rect.width);
            const dpr = window.devicePixelRatio || 1;
            canvas.width = size * dpr;
            canvas.height = size * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            drawArena();
        }

        function drawArena() {
            const dpr = window.devicePixelRatio || 1;
            const totalSize = canvas.width / dpr;
            if (totalSize <= 0) return;

            // Coordinate ruler margin along top and left (0-9)
            const rulerMargin = Math.max(20, Math.floor(totalSize * 0.052));
            const boardSize = totalSize - rulerMargin - 2;
            const cellSize = boardSize / GRID_SIZE;

            const showHeatmap = document.getElementById('toggleHeatmap').checked;
            const showArrows = document.getElementById('toggleArrows').checked;

            ctx.clearRect(0, 0, totalSize, totalSize);
            ctx.fillStyle = '#FFFFFF';
            ctx.fillRect(0, 0, totalSize, totalSize);

            // 1. Draw Top & Left Coordinate Rulers (0..9)
            ctx.fillStyle = '#52525B';
            ctx.font = `500 ${Math.max(9, Math.floor(rulerMargin * 0.52))}px "JetBrains Mono", monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            for (let i = 0; i < GRID_SIZE; i++) {
                const pos = rulerMargin + (i + 0.5) * cellSize;
                ctx.fillText(String(i), pos, rulerMargin * 0.5);
                ctx.fillText(String(i), rulerMargin * 0.48, pos);
            }

            // 2. Draw Grid Cells & Monochrome Q-Value Heatmap
            for (let r = 0; r < GRID_SIZE; r++) {
                for (let c = 0; c < GRID_SIZE; c++) {
                    const node = graph.nodes[r][c];
                    const x = rulerMargin + c * cellSize;
                    const y = rulerMargin + r * cellSize;

                    ctx.fillStyle = '#FFFFFF';
                    ctx.fillRect(x, y, cellSize, cellSize);

                    // Subtle Grayscale Heatmap based on Max Q-value
                    if (showHeatmap && (node.type === 'EMPTY' || node.type === 'START' || node.type === 'BONUS' || node.type === 'BOOST' || node.type === 'PORTAL_A' || node.type === 'PORTAL_B')) {
                        const maxQ = node.getMaxQ();
                        if (maxQ > 0.25) {
                            const alpha = Math.min(0.22, (maxQ / 95) * 0.22);
                            ctx.fillStyle = `rgba(10, 10, 10, ${alpha})`;
                            ctx.fillRect(x, y, cellSize, cellSize);
                        } else if (maxQ < -0.5) {
                            ctx.fillStyle = '#F4F4F5';
                            ctx.fillRect(x, y, cellSize, cellSize);
                        }
                    }

                    // Render Special Game Tiles
                    if (node.type === 'WALL') {
                        drawWallTile(x, y, cellSize);
                    } else if (node.type === 'TRAP') {
                        drawTrapTile(x, y, cellSize);
                    } else if (node.type === 'GOAL') {
                        drawGoalTile(x, y, cellSize);
                    } else if (node.type === 'START') {
                        drawStartTile(x, y, cellSize);
                    } else if (node.type === 'BOOST') {
                        drawBoostTile(x, y, cellSize, node.boostDir);
                    } else if (node.type === 'PORTAL_A' || node.type === 'PORTAL_B') {
                        drawPortalTile(x, y, cellSize, node.type === 'PORTAL_A' ? 'A' : 'B');
                    } else if (node.type === 'BONUS') {
                        drawBonusTile(x, y, cellSize, collectedBonus[r][c]);
                    }

                    // Cell Hairline Border
                    ctx.strokeStyle = '#E4E4E7';
                    ctx.lineWidth = 1;
                    ctx.strokeRect(x, y, cellSize, cellSize);

                    // 3. Draw Learned Policy Arrow in Walkable Cells
                    if (showArrows && (node.type === 'EMPTY' || node.type === 'BONUS')) {
                        const bestEdge = node.getBestEdge();
                        if (bestEdge !== null && Math.abs(bestEdge.qValue) > 0.05) {
                            drawPolicyArrow(
                                x + cellSize / 2,
                                y + cellSize / 2,
                                cellSize * 0.24,
                                bestEdge.dir,
                                node.type === 'BONUS' && !collectedBonus[r][c] ? 0.35 : 0.85
                            );
                        }
                    }
                }
            }

            // 4. Draw Dashed Wormhole Link Line between Portal A and Portal B
            if (graph.portalANode !== null && graph.portalBNode !== null) {
                const ax = rulerMargin + (graph.portalANode.col + 0.5) * cellSize;
                const ay = rulerMargin + (graph.portalANode.row + 0.5) * cellSize;
                const bx = rulerMargin + (graph.portalBNode.col + 0.5) * cellSize;
                const by = rulerMargin + (graph.portalBNode.row + 0.5) * cellSize;

                ctx.save();
                ctx.strokeStyle = 'rgba(10, 10, 10, 0.32)';
                ctx.lineWidth = 1.25;
                ctx.setLineDash([4, 4]);
                ctx.beginPath();
                ctx.moveTo(ax, ay);
                ctx.lineTo(bx, by);
                ctx.stroke();
                ctx.restore();
            }

            // 5. Draw Active TrajectoryStack Breadcrumb Trail
            if (trajectoryStack.top !== null) {
                ctx.save();
                ctx.strokeStyle = '#0A0A0A';
                ctx.lineWidth = appState.stackStatus === 'POPPING' ? 2.8 : 2;
                ctx.setLineDash(appState.stackStatus === 'POPPING' ? [] : [3, 3]);
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';

                ctx.beginPath();
                let curr = trajectoryStack.top;
                let isFirst = true;
                while (curr !== null) {
                    const tx = rulerMargin + (curr.edge.targetNode.col + 0.5) * cellSize;
                    const ty = rulerMargin + (curr.edge.targetNode.row + 0.5) * cellSize;
                    const fx = rulerMargin + (curr.node.col + 0.5) * cellSize;
                    const fy = rulerMargin + (curr.node.row + 0.5) * cellSize;

                    if (isFirst) {
                        ctx.moveTo(tx, ty);
                        isFirst = false;
                    }
                    ctx.lineTo(fx, fy);
                    curr = curr.next;
                }
                ctx.stroke();
                ctx.restore();
            }

            // 6. Highlight Edge Currently Being Popped During Backpropagation
            if (appState.activeBackpropEdge !== null) {
                const { fromNode, toNode } = appState.activeBackpropEdge;
                const fx = rulerMargin + (fromNode.col + 0.5) * cellSize;
                const fy = rulerMargin + (fromNode.row + 0.5) * cellSize;
                const tx = rulerMargin + (toNode.col + 0.5) * cellSize;
                const ty = rulerMargin + (toNode.row + 0.5) * cellSize;

                ctx.save();
                ctx.strokeStyle = '#0A0A0A';
                ctx.lineWidth = 4.5;
                ctx.lineCap = 'round';
                ctx.beginPath();
                ctx.moveTo(fx, fy);
                ctx.lineTo(tx, ty);
                ctx.stroke();
                ctx.restore();
            }

            // 7. Crisp Outer Arena Border
            ctx.strokeStyle = '#0A0A0A';
            ctx.lineWidth = 1.5;
            ctx.strokeRect(rulerMargin, rulerMargin, boardSize, boardSize);

            // 8. Inspected Cell Selection Frame
            if (appState.inspectedNode !== null) {
                const ix = rulerMargin + appState.inspectedNode.col * cellSize;
                const iy = rulerMargin + appState.inspectedNode.row * cellSize;
                ctx.save();
                ctx.strokeStyle = '#0A0A0A';
                ctx.lineWidth = 2.5;
                ctx.strokeRect(ix + 1.5, iy + 1.5, cellSize - 3, cellSize - 3);
                ctx.restore();
            }

            // 9. Autonomous Agent Rover Marker
            if (appState.agentNode !== null) {
                const ax = rulerMargin + (appState.agentNode.col + 0.5) * cellSize;
                const ay = rulerMargin + (appState.agentNode.row + 0.5) * cellSize;
                const r = cellSize * 0.28;

                ctx.save();
                ctx.beginPath();
                ctx.arc(ax, ay, r + 2.5, 0, Math.PI * 2);
                ctx.fillStyle = '#FFFFFF';
                ctx.fill();

                ctx.beginPath();
                ctx.arc(ax, ay, r, 0, Math.PI * 2);
                ctx.fillStyle = '#0A0A0A';
                ctx.fill();

                ctx.beginPath();
                ctx.arc(ax, ay, r * 0.42, 0, Math.PI * 2);
                ctx.fillStyle = '#FFFFFF';
                ctx.fill();
                ctx.restore();
            }
        }

        function drawWallTile(x, y, size) {
            ctx.save();
            ctx.beginPath();
            ctx.rect(x, y, size, size);
            ctx.clip();

            ctx.fillStyle = '#FAFAFA';
            ctx.fillRect(x, y, size, size);

            ctx.strokeStyle = '#0A0A0A';
            ctx.lineWidth = 1.25;
            const step = 6;
            for (let d = -size; d < size * 2; d += step) {
                ctx.beginPath();
                ctx.moveTo(x + d, y + size);
                ctx.lineTo(x + d + size, y);
                ctx.stroke();
            }
            ctx.restore();
        }

        function drawStartTile(x, y, size) {
            const pad = size * 0.18;
            ctx.save();
            ctx.fillStyle = '#0A0A0A';
            ctx.fillRect(x + pad, y + pad, size - pad * 2, size - pad * 2);

            ctx.fillStyle = '#FFFFFF';
            ctx.font = `700 ${Math.max(10, Math.floor(size * 0.34))}px "JetBrains Mono", monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('S', x + size / 2, y + size / 2 + 0.5);
            ctx.restore();
        }

        function drawGoalTile(x, y, size) {
            const cx = x + size / 2;
            const cy = y + size * 0.44;
            const outerR = size * 0.26;
            ctx.save();
            ctx.strokeStyle = '#0A0A0A';
            ctx.lineWidth = 1.8;
            ctx.beginPath();
            ctx.arc(cx, cy, outerR, 0, Math.PI * 2);
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(cx, cy, outerR * 0.45, 0, Math.PI * 2);
            ctx.fillStyle = '#0A0A0A';
            ctx.fill();

            ctx.fillStyle = '#0A0A0A';
            ctx.font = `700 ${Math.max(7, Math.floor(size * 0.17))}px "JetBrains Mono", monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'bottom';
            ctx.fillText('+100', cx, y + size - 3);
            ctx.restore();
        }

        function drawTrapTile(x, y, size) {
            const cx = x + size / 2;
            const cy = y + size * 0.44;
            const r = size * 0.24;
            ctx.save();
            ctx.strokeStyle = '#0A0A0A';
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.arc(cx, cy, r, 0, Math.PI * 2);
            ctx.stroke();

            const d = r * 0.55;
            ctx.beginPath();
            ctx.moveTo(cx - d, cy - d);
            ctx.lineTo(cx + d, cy + d);
            ctx.moveTo(cx + d, cy - d);
            ctx.lineTo(cx - d, cy + d);
            ctx.stroke();

            ctx.fillStyle = '#0A0A0A';
            ctx.font = `700 ${Math.max(7, Math.floor(size * 0.17))}px "JetBrains Mono", monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'bottom';
            ctx.fillText('-50', cx, y + size - 3);
            ctx.restore();
        }

        function drawBoostTile(x, y, size, dir) {
            const cx = x + size / 2;
            const cy = y + size / 2;
            const angles = { RIGHT: 0, DOWN: Math.PI / 2, LEFT: Math.PI, UP: -Math.PI / 2 };

            ctx.save();
            ctx.fillStyle = '#F4F4F5';
            ctx.fillRect(x + 2, y + 2, size - 4, size - 4);

            ctx.translate(cx, cy);
            ctx.rotate(angles[dir] || 0);

            ctx.strokeStyle = '#0A0A0A';
            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            const s = size * 0.16;
            ctx.beginPath();
            ctx.moveTo(-s * 1.1, -s);
            ctx.lineTo(-s * 0.1, 0);
            ctx.lineTo(-s * 1.1, s);

            ctx.moveTo(s * 0.2, -s);
            ctx.lineTo(s * 1.2, 0);
            ctx.lineTo(s * 0.2, s);
            ctx.stroke();
            ctx.restore();
        }

        function drawPortalTile(x, y, size, label) {
            const cx = x + size / 2;
            const cy = y + size / 2;
            const r = size * 0.31;

            ctx.save();
            ctx.strokeStyle = '#0A0A0A';
            ctx.lineWidth = 1.6;
            ctx.setLineDash([3, 2]);
            ctx.beginPath();
            ctx.arc(cx, cy, r, 0, Math.PI * 2);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = '#0A0A0A';
            ctx.font = `700 ${Math.max(10, Math.floor(size * 0.30))}px "JetBrains Mono", monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(label, cx, cy + 0.5);
            ctx.restore();
        }

        function drawBonusTile(x, y, size, isCollected) {
            const cx = x + size / 2;
            const cy = y + size / 2;
            const r = size * 0.27;

            ctx.save();
            ctx.strokeStyle = isCollected ? '#A1A1AA' : '#0A0A0A';
            ctx.lineWidth = 1.6;
            if (isCollected) ctx.setLineDash([2, 2]);

            ctx.beginPath();
            ctx.moveTo(cx, cy - r);
            ctx.lineTo(cx + r, cy);
            ctx.lineTo(cx, cy + r);
            ctx.lineTo(cx - r, cy);
            ctx.closePath();
            ctx.stroke();

            if (!isCollected) {
                ctx.fillStyle = '#0A0A0A';
                ctx.font = `700 ${Math.max(7, Math.floor(size * 0.16))}px "JetBrains Mono", monospace`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('+25', cx, cy + 0.5);
            }
            ctx.restore();
        }

        function drawPolicyArrow(cx, cy, size, dir, opacity = 0.85) {
            const angles = { UP: -Math.PI / 2, DOWN: Math.PI / 2, LEFT: Math.PI, RIGHT: 0 };
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(angles[dir] || 0);
            ctx.strokeStyle = `rgba(10, 10, 10, ${opacity})`;
            ctx.lineWidth = 1.75;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';

            ctx.beginPath();
            ctx.moveTo(-size * 0.65, 0);
            ctx.lineTo(size * 0.65, 0);
            ctx.moveTo(size * 0.18, -size * 0.42);
            ctx.lineTo(size * 0.68, 0);
            ctx.lineTo(size * 0.18, size * 0.42);
            ctx.stroke();
            ctx.restore();
        }

        /* ============================================================================
           SECTION 8: CANVAS POINTER HANDLING (INSPECT VS EDIT MODE)
           ============================================================================ */

        function getCellFromPointerEvent(evt) {
            const rect = canvas.getBoundingClientRect();
            const clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
            const clientY = evt.touches ? evt.touches[0].clientY : evt.clientY;
            const relX = clientX - rect.left;
            const relY = clientY - rect.top;

            const rulerMargin = Math.max(20, Math.floor(rect.width * 0.052));
            const boardSize = rect.width - rulerMargin - 2;
            const bx = relX - rulerMargin;
            const by = relY - rulerMargin;

            if (bx < 0 || by < 0 || bx >= boardSize || by >= boardSize) return null;

            const col = Math.floor((bx / boardSize) * GRID_SIZE);
            const row = Math.floor((by / boardSize) * GRID_SIZE);
            return graph.getNode(row, col);
        }

        function paintTileWithBrush(node, isInitialClick = false) {
            if (node === null) return;
            const brush = appState.activeBrush;

            // Protect Start and Goal from accidental overwrite unless explicitly setting Start/Goal
            if ((node === graph.startNode || node === graph.goalNode) && brush !== 'START' && brush !== 'GOAL') {
                appState.inspectedNode = node;
                renderAll();
                return;
            }

            if (brush === 'START') {
                if (node === graph.goalNode) return;
                graph.startNode.type = 'EMPTY';
                graph.startNode = node;
                node.type = 'START';
                appState.agentNode = node;
            } else if (brush === 'GOAL') {
                if (node === graph.startNode) return;
                graph.goalNode.type = 'EMPTY';
                graph.goalNode = node;
                node.type = 'GOAL';
            } else if (brush === 'BOOST') {
                if (node.type === 'BOOST' && isInitialClick) {
                    let nextIdx = 0;
                    for (let i = 0; i < 4; i++) {
                        if (BOOST_CYCLE[i] === node.boostDir) {
                            nextIdx = (i + 1) % 4;
                            break;
                        }
                    }
                    node.boostDir = BOOST_CYCLE[nextIdx];
                    appState.brushBoostDir = node.boostDir;
                    updateBoostBrushUI();
                } else {
                    node.type = 'BOOST';
                    node.boostDir = appState.brushBoostDir;
                }
            } else if (brush === 'PORTAL_A') {
                if (graph.portalANode !== null && graph.portalANode !== node) {
                    graph.portalANode.type = 'EMPTY';
                }
                node.type = 'PORTAL_A';
            } else if (brush === 'PORTAL_B') {
                if (graph.portalBNode !== null && graph.portalBNode !== node) {
                    graph.portalBNode.type = 'EMPTY';
                }
                node.type = 'PORTAL_B';
            } else {
                if (node.type === brush) {
                    appState.inspectedNode = node;
                    renderAll();
                    return;
                }
                node.type = brush;
            }

            graph.rebuildEdges(false);
            updateReachabilityStatus();
            appState.inspectedNode = node;
            renderAll();
        }


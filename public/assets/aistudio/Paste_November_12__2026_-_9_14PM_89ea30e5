                statusBar.innerHTML = `<span>TOP → Step #${trajectoryStack.top ? trajectoryStack.top.stepNum : 0}</span><span class="font-semibold">PUSH O(1)</span>`;
            } else if (appState.stackStatus === 'POPPING') {
                statusBar.className = 'px-3 py-2 rounded-lg border border-[#0A0A0A] bg-[#0A0A0A] font-mono text-xs text-white flex items-center justify-between';
                statusBar.innerHTML = `<span>TOP → Popping LIFO...</span><span class="font-semibold">BELLMAN UPDATE</span>`;
            } else {
                statusBar.className = 'px-3 py-2 rounded-lg border border-[#E4E4E7] bg-[#FAFAFA] font-mono text-xs text-[#52525B] flex items-center justify-between';
